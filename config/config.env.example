# Copy to config/config.env for local development. In UAT/production these
# values come from AWS Secrets Manager (see terraform/).

# Application
NODE_ENV=development
MODE=development
# The React dev server uses 3000, so the API runs on 3001 locally.
PORT=3001

# Database (MySQL 8 / MariaDB). The database must exist; create the schema with `npm run db:setup`.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=grantmaestro
# Set to false to stop Sequelize printing every SQL statement.
# DB_LOGGING=false

# Authentication (signs access and refresh tokens). Use a long random value.
JWT_SECRET=replace_with_a_long_random_secret

# Encrypts secrets saved in the admin UI (Stripe, Pin Payments, SES keys).
# Exactly 32 and 16 characters. Changing them makes saved secrets unreadable.
SETTINGS_ENCRYPTION_KEY=replace_with_32_characters______
SETTINGS_ENCRYPTION_IV=replace_16_chars

# Frontend and CORS
FRONTEND_URL=http://localhost:3000
# Comma-separated list of additional allowed origins
CORS_ORIGINS=http://localhost:3000

# AWS. Without keys, the SDK uses the ECS task role (UAT/production).
# Locally, uploads need these keys; without them files are not stored.
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=grantmaestro-uploads
# AWS_S3_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net

# Email (AWS SES). The Platform Admin's Email Settings page overrides these.
AWS_SES_REGION=ap-southeast-2
FROM_EMAIL=noreply@grantmaestro.com
# FROM_NAME=GrantMaestro

# Cloudflare Turnstile (public contact form and support tickets). Submissions are refused without it.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAMES=localhost,grantmaestro.com
# Base64-encoded address that receives contact form enquiries
# CONTACT_RECIPIENT_B64=

# Claude drafting assistance (optional)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_DRAFTING_MODEL=claude-haiku-4-5

# Manus portfolio readiness analysis (optional)
MANUS_READINESS_ANALYSIS_ENABLED=false
# MANUS_API_KEY=
# MANUS_API_BASE=https://api.manus.ai
# MANUS_READINESS_AGENT_PROFILE=manus-1.6-lite
# MANUS_READINESS_DAILY_LIMIT=25
# MANUS_READINESS_REQUEST_TIMEOUT_MS=12000

# Platform Admin created by `npm run db:seed` (only if the email does not exist yet).
# Use a password of at least 12 characters; remove these once the admin exists.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=

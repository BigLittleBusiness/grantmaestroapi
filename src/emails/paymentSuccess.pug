doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Payment Confirmed — Grant Maestro
    style.
      body{margin:0;padding:0;background-color:#f0f4f8;font-family:Arial,sans-serif}
      .wrapper{max-width:600px;margin:40px auto;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.08)}
      .hdr{background:#1a3c5e;padding:32px 40px;text-align:center}
      .hdr h1{margin:0;color:#fff;font-size:24px;font-weight:700}
      .hdr p{margin:6px 0 0;color:#a8c4e0;font-size:13px}
      .bdy{padding:36px 40px}
      .bdy h2{color:#1a3c5e;font-size:20px;margin:0 0 16px}
      .bdy p{color:#4a5568;font-size:15px;line-height:1.7;margin:0 0 16px}
      .receipt{background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;padding:16px 20px;margin:0 0 24px}
      .receipt p{margin:0 0 8px;font-size:14px;color:#2d3748}
      .receipt p:last-child{margin:0}
      .receipt strong{color:#166534}
      .btn{display:inline-block;margin:8px 0 24px;padding:14px 32px;background:#2563eb;color:#fff;text-decoration:none;border-radius:6px;font-size:15px;font-weight:600}
      .ftr{background:#f7fafc;padding:20px 40px;text-align:center;border-top:1px solid #e2e8f0}
      .ftr p{color:#718096;font-size:12px;margin:0;line-height:1.6}
      .ftr a{color:#2563eb;text-decoration:none}
  body
    .wrapper
      .hdr
        h1 Grant Maestro
        p Smarter Grant Management for Local Government
      .bdy
        h2 ✓ &nbsp; Payment confirmed
        p Thank you, #{name}. Your payment has been processed successfully and your Grant Maestro subscription is now active.
        .receipt
          p <strong>Organisation:</strong> &nbsp; #{orgName}
          p <strong>Plan:</strong> &nbsp; #{planName}
          p <strong>Amount paid:</strong> &nbsp; $#{amount} AUD
          p <strong>Next renewal:</strong> &nbsp; #{renewalDate}
          p <strong>Transaction reference:</strong> &nbsp; #{transactionRef}
        a.btn(href=loginUrl) Go to My Dashboard
        p Please retain this email as your payment receipt. If you have any questions about your billing, please submit a support ticket from within your dashboard.
      .ftr
        p &copy; #{year} Grant Maestro &nbsp;|&nbsp; <a href=loginUrl>Log In</a> &nbsp;|&nbsp; <a href=supportUrl>Support</a>
        p This receipt was sent to #{email}.

doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title GrantMaestro portfolio readiness request
    style.
      body{margin:0;padding:0;background:#f4f8fd;font-family:Arial,sans-serif;color:#0d0d0d}.wrapper{max-width:680px;margin:32px auto;background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 4px 18px rgba(0,26,139,.12)}.hdr{padding:28px 34px;background:#001a8b;color:#fff}.hdr h1{margin:0;font-size:23px}.hdr p{margin:6px 0 0;color:#8fdafa;font-size:13px}.bdy{padding:30px 34px}.bdy h2{margin:0 0 17px;color:#001a8b;font-size:20px}.details{padding:16px 18px;border:1px solid #d7e2f4;border-radius:8px;background:#f8fbff}.details p{margin:0 0 9px;color:#404040;font-size:14px;line-height:1.5}.details p:last-child{margin-bottom:0}.priorities{margin:22px 0}.priorities h3{margin:0 0 11px;color:#001a8b;font-size:16px}.priorities li{margin:0 0 10px;color:#404040;font-size:14px;line-height:1.5}.ftr{padding:18px 34px;border-top:1px solid #d7e2f4;background:#f8fbff;color:#56657a;font-size:12px}
  body
    .wrapper
      .hdr
        h1 GrantMaestro
        p Portfolio readiness action-plan request
      .bdy
        h2 New action-plan request
        .details
          p
            strong Name:
            |  #{firstName}
          p
            strong Organisation:
            |  #{organisation}
          p
            strong Role:
            |  #{role}
          p
            strong Email:
            |  #{email}
          p
            strong Snapshot result:
            |  #{score}/100 — #{readinessLabel}
          p
            strong Received:
            |  #{receivedAt}
          p
            strong Source:
            |  #{sourceUrl}
        .priorities
          h3 Lowest-scoring focus areas
          ul
            each priority in priorities
              li
                strong #{priority.title}:
                |  #{priority.detail}
      .ftr
        | This alert was generated by the GrantMaestro portfolio readiness form.

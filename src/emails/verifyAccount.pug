doctype html
html
  head
    meta(charset="UTF-8")
    title Verify Your Grant Maestro Account
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        padding: 20px;
        margin: 0;
      }
      .container {
        max-width: 600px;
        margin: auto;
        background: #ffffff;
        padding: 32px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
      .logo {
        text-align: center;
        margin-bottom: 24px;
      }
      h1 {
        color: #1a1a2e;
        font-size: 22px;
        margin-bottom: 8px;
      }
      p {
        font-size: 15px;
        color: #555;
        line-height: 1.6;
      }
      .otp-box {
        text-align: center;
        margin: 28px 0;
      }
      .otp-code {
        display: inline-block;
        font-size: 36px;
        font-weight: 700;
        letter-spacing: 10px;
        color: #1a1a2e;
        background: #f0f4ff;
        border: 2px dashed #007bff;
        border-radius: 8px;
        padding: 16px 32px;
      }
      .note {
        font-size: 13px;
        color: #999;
        margin-top: 24px;
      }
      .footer-note {
        margin-top: 32px;
        padding-top: 16px;
        border-top: 1px solid #eee;
        font-size: 12px;
        color: #bbb;
        text-align: center;
      }
  body
    .container
      h1 Verify Your Grant Maestro Account
      p Hi #{firstName},
      p Thank you for registering with Grant Maestro. To complete your account setup and access your dashboard, please enter the verification code below.
      .otp-box
        .otp-code #{otpCode}
      p This code is valid for <strong>15 minutes</strong>. If you did not create a Grant Maestro account, you can safely ignore this email.
      p.note If you have any trouble, use the <a href=supportUrl>support form</a>.
      .footer-note
        p &copy; #{year} Grant Maestro. All rights reserved. &nbsp;|&nbsp; Australian Hosted &nbsp;|&nbsp; Data Privacy Compliant
